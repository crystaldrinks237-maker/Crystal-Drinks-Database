<%- include('../partials/header') %>
<%- include('../partials/admin-nav', { active: 'expenses' }) %>
<div class="container">
  <h1>Expenses</h1>

  <div class="grid grid-3">
    <% totalsByCategory.forEach(t => { %>
      <div class="card stat">
        <div class="num"><%= t.total.toFixed(0) %></div>
        <div class="label"><%= t.category.replace('_',' ') %></div>
      </div>
    <% }) %>
  </div>

  <div class="card">
    <h2>Add expense</h2>
    <p class="muted" style="margin-top:-6px">Bottle purchases and delivery petrol are logged automatically from Inventory / Deliveries. Use this for maintenance, electricity, or anything else.</p>
    <form method="POST" action="/admin/expenses">
      <div class="row">
        <div class="field">
          <label>Date</label>
          <input type="date" name="date" value="<%= new Date().toISOString().slice(0,10) %>" required>
        </div>
        <div class="field">
          <label>Category</label>
          <select name="category" required>
            <option value="maintenance">Vehicle maintenance</option>
            <option value="electricity">Electricity bill</option>
            <option value="petrol">Petrol (general)</option>
            <option value="bottles_purchase">Bottle purchase (manual)</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="field">
          <label>Amount</label>
          <input type="number" step="0.01" name="amount" required>
        </div>
      </div>
      <div class="field">
        <label>Description (optional)</label>
        <input type="text" name="description">
      </div>
      <button type="submit" class="btn">Add expense</button>
    </form>
  </div>

  <div class="card">
    <div class="top-actions">
      <h2 style="margin:0">All expenses</h2>
      <a href="/admin/expenses/export.csv" class="btn btn-sm btn-secondary">Export (CSV)</a>
    </div>
    <table>
      <thead><tr><th>Date</th><th>Category</th><th>Amount</th><th>Description</th><th></th></tr></thead>
      <tbody>
      <% expenses.forEach(e => { %>
        <tr>
          <td data-label="Date"><%= e.date %></td>
          <td data-label="Category"><%= e.category.replace('_',' ') %></td>
          <td data-label="Amount"><%= e.amount.toFixed(0) %></td>
          <td data-label="Description"><%= e.description || '-' %></td>
          <td data-label="">
            <form method="POST" action="/admin/expenses/<%= e.id %>"
              onsubmit="return confirm('Delete this expense?')" style="display:inline">
              <input type="hidden" name="_method" value="DELETE">
              <button type="submit" class="btn btn-sm btn-red">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
    <% if (expenses.length === 0) { %><p class="muted">No expenses recorded yet.</p><% } %>
  </div>
</div>
<%- include('../partials/footer') %>
