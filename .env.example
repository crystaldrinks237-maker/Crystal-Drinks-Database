# Copy this file to .env for local development, or set these same names as
# Environment Variables in Render's dashboard (Settings > Environment).
# Never commit a real .env file - it's already in .gitignore.

# The full connection string Neon gives you when you create a database -
# looks like: postgres://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL=

# A long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If you don't set this, the app generates one automatically at startup, but
# it won't survive a restart - meaning everyone gets logged out whenever the
# app redeploys or wakes up from sleep. Setting your own fixed value avoids that.
SESSION_SECRET=

PORT=3000

# --- Only used if DATABASE_URL is not set (e.g. testing against a plain
# local Postgres install instead of Neon) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=crystal_drinks
